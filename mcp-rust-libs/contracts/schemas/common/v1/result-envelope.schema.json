{
  "$defs": {
    "failure": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/safeError"
        },
        "meta": {
          "$ref": "#/$defs/metadata"
        },
        "ok": {
          "const": false
        }
      },
      "required": [
        "ok",
        "error"
      ],
      "type": "object"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "omitted_bytes": {
          "default": 0,
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "safeError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "type": "string"
        },
        "message": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$",
          "type": "string"
        },
        "path": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "type": "array"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "success": {
      "additionalProperties": false,
      "properties": {
        "data": {},
        "meta": {
          "$ref": "#/$defs/metadata"
        },
        "ok": {
          "const": true
        }
      },
      "required": [
        "ok",
        "data"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.oresoftware.com/mcp/common/v1/result-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Transport-neutral, bounded success/error envelope for reusable MCP helpers.",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/failure"
    }
  ],
  "title": "ORE MCP Result Envelope",
  "x-ore-contract-version": "1.0.0"
}
